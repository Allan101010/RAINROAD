{
  "version": 1,
  "scope": {
    "geographic": "global",
    "priority_region": "Costa Rica and Central America",
    "ingest_all_supported_events": true
  },
  "sources": [
    {
      "id": "usgs-earthquakes-all-day",
      "provider": "USGS Earthquake Hazards Program",
      "domain": "solid_earth",
      "kind": "geojson",
      "url": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson",
      "enabled": true,
      "confidence_class": "provider_reported",
      "coverage": "global",
      "notes": "All earthquakes in the past day (includes the significant ones); event thresholds and availability are controlled by USGS."
    },
    {
      "id": "gdacs-rss",
      "provider": "GDACS",
      "domain": "multi_hazard",
      "kind": "rss",
      "url": "https://www.gdacs.org/xml/rss.xml",
      "enabled": true,
      "confidence_class": "provider_reported",
      "coverage": "global",
      "notes": "Global disaster alerts; retain provider severity and links."
    },
    {
      "id": "nasa-eonet-open-events",
      "provider": "NASA EONET",
      "domain": "environment",
      "kind": "json",
      "url": "https://eonet.gsfc.nasa.gov/api/v3/events?status=open&limit=100",
      "enabled": true,
      "confidence_class": "provider_reported",
      "coverage": "global",
      "notes": "Curated open natural events; not a complete real-time sensor feed."
    },
    {
      "id": "noaa-nhc-atlantic-spanish",
      "provider": "NOAA National Hurricane Center",
      "domain": "atmosphere",
      "kind": "rss",
      "url": "https://www.nhc.noaa.gov/index-at-sp.xml",
      "enabled": true,
      "confidence_class": "official",
      "coverage": "Atlantic, Caribbean and Gulf",
      "notes": "Official Spanish-language tropical cyclone updates and outlooks."
    },
    {
      "id": "noaa-nhc-east-pacific-spanish",
      "provider": "NOAA National Hurricane Center",
      "domain": "atmosphere",
      "kind": "rss",
      "url": "https://www.nhc.noaa.gov/index-ep-sp.xml",
      "enabled": true,
      "confidence_class": "official",
      "coverage": "Eastern Pacific",
      "notes": "Official Spanish-language tropical cyclone updates and outlooks."
    },
    {
      "id": "noaa-swpc-alerts",
      "provider": "NOAA Space Weather Prediction Center",
      "domain": "space_weather",
      "kind": "swpc_json",
      "url": "https://services.swpc.noaa.gov/products/alerts.json",
      "enabled": true,
      "confidence_class": "official",
      "coverage": "global",
      "notes": "Official space-weather alerts, watches and warnings."
    },
    {
      "id": "imn-costa-rica-cap-alerts",
      "provider": "Instituto Meteorológico Nacional de Costa Rica",
      "domain": "atmosphere",
      "kind": "cap_rss",
      "url": "https://cap-sources.s3.amazonaws.com/cr-imn-es/rss.xml",
      "enabled": true,
      "confidence_class": "official",
      "coverage": "Costa Rica",
      "notes": "Official CAP alert feed; preserve severity, urgency, certainty, area and expiry when published."
    },
    {
      "id": "rsn-ucr-felt-earthquakes-rss",
      "provider": "Red Sismológica Nacional UCR",
      "domain": "solid_earth",
      "kind": "rsn_rss",
      "url": "https://rsn.ucr.ac.cr/actividad-sismica/ultimos-sismos?format=feed&type=rss",
      "enabled": true,
      "confidence_class": "provider_reported",
      "coverage": "Costa Rica and nearby region",
      "notes": "RSN published recent felt-earthquake reports. Supplementary to USGS; not a complete real-time seismic catalog."
    }
  ],
  "planned_sources": [
    {
      "provider": "OVSICORI-UNA and RSN",
      "domain": "solid_earth",
      "status": "planned",
      "reason": "Confirm stable public machine-readable event endpoints before enabling ingestion."
    },
    {
      "provider": "CNE Costa Rica",
      "domain": "multi_hazard",
      "status": "planned",
      "reason": "Integrate official public emergency advisories with clear attribution."
    }
  ],
  "polling": {
    "note": "Every enabled source is polled on each run of the global-hazard-monitor workflow (every 10 minutes)."
  }
}
