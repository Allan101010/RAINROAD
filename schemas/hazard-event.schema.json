{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raintrack-cr.github.io/schemas/hazard-event.schema.json",
  "title": "RainTrack Global Hazard Event",
  "description": "Normalized event record; source observations remain attributable and uncertainty is explicit.",
  "type": "object",
  "required": [
    "event_id",
    "hazard_type",
    "title",
    "status",
    "confidence_class",
    "source",
    "observed_at",
    "ingested_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "provider_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "hazard_type": {
      "type": "string",
      "enum": [
        "earthquake",
        "volcano",
        "tropical_cyclone",
        "severe_storm",
        "flood",
        "landslide",
        "tsunami",
        "wildfire",
        "drought",
        "extreme_heat",
        "extreme_cold",
        "air_quality",
        "atmospheric_wave",
        "front",
        "atmospheric_river",
        "enso",
        "space_weather",
        "solar_flare",
        "geomagnetic_storm",
        "near_earth_object",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "updated",
        "resolved",
        "unknown"
      ]
    },
    "severity": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "unknown",
        "minor",
        "moderate",
        "severe",
        "extreme",
        null
      ]
    },
    "confidence_class": {
      "type": "string",
      "enum": [
        "official",
        "provider_reported",
        "automated_detection",
        "model_estimate",
        "unverified"
      ]
    },
    "confidence_score": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "location": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "depth_km": {
          "type": [
            "number",
            "null"
          ]
        },
        "place_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "country_code": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "additionalProperties": false
    },
    "geometry": {
      "type": [
        "object",
        "null"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "source": {
      "type": "object",
      "required": [
        "provider",
        "url"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "raw_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "ingested_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "region_priority": {
      "type": "string",
      "enum": [
        "costa_rica_central_america",
        "global"
      ]
    },
    "correlation_group_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "official_advisory_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    }
  },
  "additionalProperties": false
}
